# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-hex-characters
# Choose a unique password; do not commit this file.
ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=3000
DATA_DIR=./data

SECURE_COOKIES=false

# Behind Caddy: use the client address from X-Forwarded-For (rate limits, unique visitors).
TRUST_PROXY=false
SITE_HOST=medamine.work

# Telegram notifications (optional). Create a bot with @BotFather, send it a message,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# each = a message per new visitor (max 30/hour) + daily digest; digest = daily digest only; off = messages only
TELEGRAM_VISITS=each
# Hour (UTC, 0-23) to send the daily visits digest
TELEGRAM_DIGEST_HOUR=20
